// Emits the library: src/**/*.ts → dist/*.js + .d.ts (ESM). The DOM lib is needed for
// fetch/WebAssembly/AudioContext types; Node APIs are reached only through a dynamic
// import, so no Node types leak into the browser build.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
