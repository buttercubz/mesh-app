{
  "name": "@meshapp/capacitor-intercom",
  "version": "0.1.0",
  "private": true,
  "description": "TS-only Capacitor plugin MeshIntercom (WP-17, DESIGN §11.1, contract C6): definitions, registerPlugin and the web implementation. Native bridges are app-local (WP-19).",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@meshapp/engine-api": "workspace:*",
    "@meshapp/engine-web": "workspace:*"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/core": "~8.5.3",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
