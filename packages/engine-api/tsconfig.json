// Type-check everything in the package (sources, generated types, tests, configs); no emit.
// The build uses tsconfig.build.json, which emits src/ (minus tests) into dist/.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
