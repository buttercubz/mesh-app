// @meshapp/mobile TypeScript config (WP-18, DESIGN §11.3): extends the shared base
// (strict, verbatimModuleSyntax, erasableSyntaxOnly). Type-checked by `pnpm build`
// (`tsc --noEmit`); Vite emits the bundle.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "capacitor.config.ts"
  ]
}
