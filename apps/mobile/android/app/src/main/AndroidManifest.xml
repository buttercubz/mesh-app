<?xml version="1.0" encoding="utf-8"?>
<!--
  convLink Voice app manifest (WP-18, DESIGN §10.2.4). Radio, audio, FGS and location
  permissions come from the :meshengine library manifest (WP-16) through manifest
  merging. Static contract: apps/mobile/tests/android-manifest.test.mjs.
  - No INTERNET: the app is 100 % offline (L8); the WebView serves bundled assets.
  - ACCESS_LOCAL_NETWORK is NOT declared at target 36 (only when targeting 37, for Wi-Fi
    Aware sockets); the remove marker keeps any dependency from adding it.
  - Backup and data-extraction rules exclude the engine's secure store (per-group keys).
  - Portrait only. At targetSdk 36, Android 16 ignores screenOrientation on large screens
    (sw >= 600dp, e.g. Galaxy Tab) unless PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY is
    set; the property stops working at target 37, so the ride layout also handles wide
    landscape and short split-screen windows.
  - fontScale/fontWeightAdjustment in configChanges: MainActivity re-applies the WebView
    text zoom instead of the activity being recreated (WebView reload) mid-ride.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" tools:node="remove" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="36">

        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|fontWeightAdjustment"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Group invites: convlinkvoice://join?v=1#<invite> (camera app or another app). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="convlinkvoice" android:host="join" />
            </intent-filter>
        </activity>

        <!-- Lab export through the share sheet (shareFile). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
