<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by default (driving rule, DESIGN §11.4); the WebView draws the app theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/convlink_surface</item>
        <item name="colorPrimaryDark">@color/convlink_background</item>
        <item name="colorAccent">@color/convlink_brand</item>
        <item name="android:windowBackground">@color/convlink_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/convlink_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
