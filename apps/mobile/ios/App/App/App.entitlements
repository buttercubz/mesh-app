<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App entitlements (WP-18, DESIGN §10.1.5). Time-sensitive notifications carry the
  "Mic paused, tap to resume" alert (§10.1.4). Phase 4 adds
  com.apple.developer.wifi-aware = [Publish, Subscribe] once Apple grants it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
