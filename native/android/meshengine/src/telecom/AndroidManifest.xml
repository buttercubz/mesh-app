<?xml version="1.0" encoding="utf-8"?>
<!-- Telecom overlay (DESIGN §10.2.2), merged only when meshengine.telecom=true: Jetpack
     Core-Telecom self-managed call with the phoneCall FGS type. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <application>
        <service
            android:name="com.convlink.voice.engine.MeshEngineService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice|location|phoneCall"
            tools:replace="android:foregroundServiceType" />
    </application>
</manifest>
